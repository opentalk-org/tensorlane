from pathlib import Path
from socket import socket
from typing import Any

class Daemon:
    def __init__(
        self,
        run_id: str,
        addr: str,
        root: Path,
        ranks: int,
        prefetch_factor: int,
        num_workers: int,
    ) -> None: ...
    @property
    def run_id(self) -> str: ...
    @property
    def train_config(self) -> str: ...
    def close(self) -> None: ...
    def stop(self, error: str | None = None) -> None: ...

class Listener:
    def __init__(self, socket: socket) -> None: ...
    def recv(self) -> dict[str, Any] | None: ...
    def close(self) -> None: ...

class Semaphore:
    def __init__(self, name: str) -> None: ...
    def post(self) -> None: ...
